@page
@model ErrorModel
@{
    // Esta página demuestra cómo ASP.NET Core maneja errores y ofrece una vista amigable al usuario.
    ViewData["Title"] = "Error";
}

<div class="alert alert-danger" role="alert">
    <h1 class="text-danger">Ha ocurrido un error</h1>
    <p class="mb-0">Esta pantalla es una demostración de cómo ASP.NET Core puede capturar una excepción y mostrar una respuesta controlada al usuario.</p>
</div>

@if (Model.ShowRequestId)
{
    <p>
        <strong>ID de la petición:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Modo de desarrollo</h3>
<p>
    Cuando la aplicación está en entorno de <strong>Development</strong>, ASP.NET Core puede mostrar información más detallada del problema.
</p>
<p>
    <strong>No conviene habilitar este modo en producción</strong>, porque podría revelar detalles sensibles de las excepciones a usuarios finales.
</p>
<p>
    En local, puedes activar el entorno de desarrollo estableciendo la variable <strong>ASPNETCORE_ENVIRONMENT</strong> a <strong>Development</strong>
    y reiniciando la aplicación.
</p>
