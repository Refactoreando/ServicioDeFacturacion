@page
@model IndexModel
@{
    // El título de la página aparece en la pestaña del navegador y se reutiliza en el layout.
    ViewData["Title"] = "Inicio";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h1 class="display-6 fw-bold text-primary mb-3">Bienvenido al Servicio de Facturación</h1>

                    <p class="lead mb-3">
                        Esta aplicación es una base para gestionar facturas dentro de una organización.
                    </p>

                    <p class="mb-4">
                        El objetivo es crear una herramienta corporativa sencilla para registrar y administrar documentos de facturación,
                        con una estructura clara para continuar ampliando la funcionalidad más adelante.
                    </p>

                    <div class="alert alert-info mb-4" role="alert">
                        <strong>Instrucción:</strong> utiliza la barra de navegación para acceder a las funciones disponibles de la aplicación.
                    </div>

                    <p class="mb-0 text-secondary">
                        @Model.Mensaje
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
